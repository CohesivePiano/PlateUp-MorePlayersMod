<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <DebugType>portable</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- Override on the command line if your game lives elsewhere:
       dotnet build -c Release -p:GameDir="C:\Program Files (x86)\Steam\steamapps\common\PlateUp\PlateUp" -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">D:\SteamLibrary\steamapps\common\PlateUp\PlateUp</GameDir>
    <ManagedDir>$(GameDir)\PlateUp_Data\Managed</ManagedDir>
    <PluginDir>$(GameDir)\BepInEx\plugins</PluginDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="1.*" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(ManagedDir)\Kitchen.Common.dll" Private="false" />
    <Reference Include="$(ManagedDir)\Kitchen.FranchiseMode.dll" Private="false" />
    <Reference Include="$(ManagedDir)\KitchenMode.dll" Private="false" />
    <Reference Include="$(ManagedDir)\Kitchen.Layouts.dll" Private="false" />
    <Reference Include="$(ManagedDir)\Kitchen.GameData.dll" Private="false" />
    <Reference Include="$(ManagedDir)\XNode.dll" Private="false" />
    <Reference Include="$(ManagedDir)\MessagePack.dll" Private="false" />
    <Reference Include="$(ManagedDir)\Facepunch.Steamworks.Win64.dll" Private="false" />
    <Reference Include="$(ManagedDir)\PhotonRealtime.dll" Private="false" />
    <Reference Include="$(ManagedDir)\Photon3Unity3D.dll" Private="false" />
    <Reference Include="$(ManagedDir)\Unity.Entities.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
  </ItemGroup>

  <!-- Copies the built plugin into the game's BepInEx folder, if BepInEx is installed there. -->
  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="Exists('$(GameDir)\BepInEx')">
    <MakeDir Directories="$(PluginDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginDir)" />
  </Target>

</Project>
